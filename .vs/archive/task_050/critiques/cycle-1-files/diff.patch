+    { cwd, env, stdio: ['pipe', 'pipe', 'pipe'] });
+  let stdout = '';
+  let overflow = false;
+  child.stdout.setEncoding('utf8');
+  child.stdout.on('data', (chunk) => {
+    if (stdout.length + chunk.length > MAX_EVENT_BYTES) { overflow = true; child.kill('SIGKILL'); return; }
+    stdout += chunk;
+  });
