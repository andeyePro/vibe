+
+function collect(reviewer, outcome) {
+  try {
+    if (outcome.spawnError) fail(`codex failed to start (${outcome.spawnError})`);
+    if (outcome.overflow) fail('Codex produced more event output than the panel accepts');
+    if (outcome.code !== 0) {
