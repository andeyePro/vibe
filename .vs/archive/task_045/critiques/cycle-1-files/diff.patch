+# ── `vibe codex` subcommands (task_045) ───────────────────────────────────────
+# Host-side only, mirroring `vibe repos`: they manage ~/.vibe/codex-allow on
+# the Mac and never enter workspace resolution, preflight, image build or
+# container launch. Being host-side is the whole point — if these could run
+# inside a container, the registry would be no stronger than the marker it
+# backstops. Every branch exits inside its own sub-function.
+#
+# `printf '%s\n'`, not `echo`, on every line below that names a `codex`
+# subcommand: smoke's source-adjacency drift check (checks_17_delegation.py)
+# locates the LAUNCH-HEADER line for this mount by scanning for the file's
+# first echo that also carries a lowercase "codex" and a colon, so an earlier
+# one here would silently point that check at the wrong line (this comment
+# avoids the same triple for the same reason). printf is the more portable
+# idiom for a fixed string anyway; keep it.
+
+_codex_usage() {
+  printf '%s\n' "Usage: vibe codex allow|deny|list [path]" >&2
+  exit 1
+}
+
+# _codex_canonical_path <arg> — `pwd -P` of the current directory when <arg>
+# is empty, else the canonical form of <arg>. Canonicalisation matters: the
+# registry is matched against the launcher's own `pwd -P`, so recording a
+# symlinked path would record a line no launch can ever match (fail-safe
+# toward NOT mounting, but confusing). When <arg> names something that does
+# not exist it is echoed unchanged, so `deny` can still clear a stale entry
+# for a folder that has since been deleted.
+_codex_canonical_path() {
+  local arg="${1:-}"
+  if [ -z "$arg" ]; then
+    pwd -P
+    return 0
+  fi
+  if [ -d "$arg" ]; then
+    (cd "$arg" 2>/dev/null && pwd -P) || printf '%s\n' "$arg"
+  else
+    printf '%s\n' "$arg"
+  fi
+}
+
+# _codex_allow [path] — record the project in the machine's consent registry.
+# Refuses anything that is not a directory, and anything that is not a git
+# work tree: the marker gate in _codex_opted_in verifies untrackedness with
+# git, so a non-git folder could never satisfy it anyway, and recording one
+# would leave a line that looks like consent but can never take effect.
+# It NEVER creates the .vibe-allow-codex marker — two independent switches,
+# in two places only the user can reach both of, is the design.
+_codex_allow() {
+  local arg="${1:-}" path
+  if [ -n "$arg" ] && [ ! -d "$arg" ]; then
+    printf '%s\n' "vibe codex allow: '$arg' is not a directory" >&2
+    exit 1
+  fi
+  path="$(_codex_canonical_path "$arg")"
+  if [ "$(git -C "$path" rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
+    printf '%s\n' "vibe codex allow: '$path' is not a git work tree — refused (the Codex login mount is only ever granted to a verifiable git project)" >&2
+    exit 1
+  fi
+  if ! codex_allow_record "$path"; then
+    printf '%s\n' "vibe codex allow: could not record '$path' in $CODEX_ALLOW_FILE" >&2
+    exit 1
+  fi
+  echo "  ✓ $path allowed to mount the Codex login (~/.vibe/codex-allow)"
+  printf '%s\n' "    Still required in that project: an untracked .vibe-allow-codex marker (touch .vibe-allow-codex). This command never creates it."
+  echo "    Relaunch (vibe) — the launcher recreates the container automatically when the mount set changes."
+  exit 0
+}
+
+# _codex_deny [path] — withdraw consent, and make the withdrawal immediate.
+# Removing the line stops the NEXT launch from mounting the login, but a
+# container started while the grant stood still has the token bound right
+# now, so deny offers to stop it. `docker stop`, never `docker rm`: stopping
+# unmounts the credential (that is the whole requirement) while leaving the
+# container, its state and any running work recoverable — removal is a
+# destructive act the user has not asked for.
+#
+# The prompt is skipped and the stop runs UNCONDITIONALLY when stdin is not a
+# TTY or VIBE_CODEX_DENY_YES=1 is set — a revocation invoked from a script or
+# a pipe must not silently leave the credential mounted because nobody was
+# there to answer. That skip lives here and nowhere else: ask_yes_no is a
+# general-purpose prompt used by unrelated flows and is NOT modified.
+_codex_deny() {
+  local arg="${1:-}" path ids do_stop
+  path="$(_codex_canonical_path "$arg")"
+  if ! codex_registry_usable; then
+    printf '%s\n' "vibe codex deny: $CODEX_ALLOW_FILE is unusable — refusing to rewrite it" >&2
+    exit 1
+  fi
+  if codex_allowed "$path"; then
+    codex_allow_remove "$path"
+    echo "  ✓ $path removed from ~/.vibe/codex-allow"
+  else
+    echo "  ✓ $path removed from ~/.vibe/codex-allow (already absent)"
+  fi
+
+  ids=$(docker ps -aq --filter "label=devcontainer.local_folder=$path" 2>/dev/null) || ids=""
+  if [ -n "$ids" ]; then
+    do_stop=1
+    if [ -t 0 ] && [ "${VIBE_CODEX_DENY_YES:-}" != "1" ]; then
+      ask_yes_no "Stop the container for $path now so the login is unmounted immediately?" y || do_stop=0
+    fi
+    if [ "$do_stop" = "1" ]; then
+      # Word-splitting is intended: docker ps -aq emits one id per line.
+      # shellcheck disable=SC2086
+      docker stop $ids >/dev/null 2>&1 || true
+      echo "  ✓ container stopped — the Codex login is no longer mounted"
+    else
+      echo "    Container left running; it keeps the login mounted until it stops."
+    fi
+  fi
+  exit 0
+}
+
+# _codex_list — show every allowed project with whether its in-tree marker is
+# also present, since BOTH are required. A registry line on its own mounts
+# nothing, so the status suffix is the difference between "armed" and "half
+# configured". Always exits 0 (listing has no validation-failure mode); an
+# unusable registry prints its own ⚠ line and then `(none)`, which is exactly
+# what such a registry grants.
+_codex_list() {
+  local line found=0
+  if ! codex_registry_usable || [ ! -f "$CODEX_ALLOW_FILE" ]; then
+    echo "  (none)"
+    exit 0
+  fi
+  while IFS= read -r line; do
+    [ -n "$line" ] || continue
+    found=1
+    if [ ! -d "$line" ]; then
+      echo "  $line (path missing)"
+    elif [ -e "$line/.vibe-allow-codex" ]; then
+      echo "  $line (marker present)"
+    else
+      echo "  $line (no marker – not mounted)"
+    fi
+  done < "$CODEX_ALLOW_FILE"
+  [ "$found" -eq 1 ] || echo "  (none)"
+  exit 0
+}
