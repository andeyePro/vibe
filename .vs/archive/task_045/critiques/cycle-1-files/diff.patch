+
+# ── Host-side Codex opt-in registry (~/.vibe/codex-allow, task_045) ───────────
+# The .vibe-allow-codex marker lives INSIDE the project tree, which is exactly
+# the filesystem a container can write. guard-fs.sh denies the structured
+# (Write/Edit) writes and guard-bash.sh best-effort-blocks the shell idioms,
+# but a prompt-injected session can still create that marker by a path the
+# Bash hook cannot see (`curl -o`, git plumbing such as `update-index
+# --cacheinfo` + `checkout-index`, `git restore --source`, an indirected
+# `M=.vibe-allow-codex; touch "$M"`), and the user's NEXT launch would bind a
+# live ChatGPT OAuth token into that same container. So the marker alone is
+# deliberately NOT sufficient any more: the mount also requires a line in this
+# machine-local registry, which lives under the Mac's $HOME and is never
+# bind-mounted into any container — nothing running inside a container can add
+# itself to it, by any idiom, because the file is not reachable from there.
+#
+# This is the ~/.vibe/repos-acks pattern applied to the credential mount, for
+# the same reason: the in-tree file states a REQUEST, the host-side registry
+# is the CONSENT, and only the user (running `vibe codex allow` on the Mac)
+# can supply the second. One canonical `pwd -P` path per line, matched
+# whole-line fixed-string (grep -qxF — no regex surface), chmod 600. There is
+# still deliberately NO machine-wide "allow everywhere" switch: a credential
+# bind that one config line could grant to every container is the shape this
+# gating exists to prevent.
+CODEX_ALLOW_FILE="$HOME/.vibe/codex-allow"
+
+# codex_registry_usable — true when ~/.vibe/codex-allow is safe to trust.
+# Fails CLOSED, with one ⚠ line, in two cases:
+#   1. the registry is a SYMLINK — a symlink could aim the consent record (or
+#      a `deny` rewrite, or the chmod) at a file the user never meant to
+#      grant, including one a container can reach through another mount; a
+#      consent record must be a real file on this machine;
+#   2. its mode grants group or others ANY bit — a consent record the rest of
+#      the machine can edit is not consent.
+# A MISSING file is usable and simply contains nothing: absence is the
+# default-off state, not an error (a first-ever launch must not warn). The
+# mode is read with the same portable stat -c/-f fallback as
+# _codex_dir_mode_warning (Linux vs. Darwin stat take different flags), and
+# only the LAST THREE octal digits are judged, so a leading setuid/setgid/
+# sticky digit never changes the verdict. An unreadable mode is treated as
+# unusable rather than assumed fine — same fail-closed direction.
+codex_registry_usable() {
+  local f="$CODEX_ALLOW_FILE" mode last3 group_other
+  if [ -L "$f" ]; then
+    echo "  ⚠ ${f} is a symlink — ignored, so no project counts as allowed (the Codex opt-in registry must be a real file on this machine; delete the symlink and re-run 'vibe codex allow')." >&2
+    return 1
+  fi
+  [ -e "$f" ] || return 0
+  mode="$(stat -L -c %a "$f" 2>/dev/null || stat -L -f %Lp "$f" 2>/dev/null)" || mode=""
+  if [ -z "$mode" ]; then
+    echo "  ⚠ ${f} permissions could not be read — ignored, so no project counts as allowed (fail closed)." >&2
+    return 1
+  fi
+  last3="${mode: -3}"
+  group_other="${last3:1:2}"
+  if [ "$group_other" != "00" ]; then
+    echo "  ⚠ ${f} is readable or writable by group or others (mode ${mode}) — ignored, so no project counts as allowed; run 'chmod 600 ${f}' on the Mac." >&2
+    return 1
+  fi
+  return 0
+}
+
+# codex_allowed <workspace> — true iff the canonical workspace path has a line
+# of its own in a usable registry. A missing registry is false (default off);
+# an unusable one is treated as ABSENT, so a tampered or world-writable file
+# grants nothing rather than everything.
+codex_allowed() {
+  local ws="$1"
+  codex_registry_usable || return 1
+  [ -f "$CODEX_ALLOW_FILE" ] || return 1
+  grep -qxF -e "$ws" "$CODEX_ALLOW_FILE"
+}
+
+# codex_allow_record <workspace> — records the path (idempotent). Refuses a
+# symlinked registry outright: `touch` and `chmod` both FOLLOW symlinks, so
+# recording through one would mutate whatever it points at. A real file with
+# a loose mode is repaired here (chmod 600) rather than refused — the user is
+# standing at the keyboard asking for exactly this grant, and leaving them
+# with a file only codex_registry_usable can explain would be a dead end.
+codex_allow_record() {
+  local ws="$1"
