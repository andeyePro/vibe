+# refresh_brain2_vibe_note — auto-maintain <brain2>/meta/vibe-operation.md
+# with the CURRENTLY INSTALLED `vibe --help` text, refreshed on every launch,
+# so an in-container Claude with no visibility into the host-side CLI (see
+# devcontainer/claude-md/vibe-cli.md) has a ground-truth reference instead of
+# guessing (task_027).
+#
+# ALWAYS returns 0 — this runs in the launch path under `set -euo pipefail`,
+# and brain2 being unmounted/unwritable must degrade silently, never abort
+# the launcher. EVERY filesystem operation below is individually guarded
+# (stderr silenced, `|| return 0` on failure) rather than relying on one
+# top-level trap, because an unguarded write into an unwritable dir under
+# errexit kills the whole sourced shell at that one statement. Belt-and-
+# braces: the call site ALSO wraps this in `|| true` (same call-context
+# errexit-suppression the task_026 setup_token fix pinned) — defence in
+# depth, not a substitute for the per-op guards here.
+#
+# Resolution: p=$(_brain2_source) is empty when brain2 is disabled
+# (VIBE_BRAIN2_PATH=off) — return 0 silently. A non-empty but non-existent
+# $p (unset/never-created brain2 root) also returns 0 — this function NEVER
+# creates the brain2 root itself, mirroring the mount-gating rule elsewhere
+# (_build_override_config only mounts /brain2 when the dir already exists).
+#
+# Managed block: markers `<!-- >>> vibe-cli-help (auto, do not edit) >>>` /
+# `<!-- <<< vibe-cli-help <<< -->` — deliberately distinct from
+# install_claude_md_fragments' `vibe-managed` markers (different file,
+# different lifecycle). Strip-and-reappend uses the SAME awk idiom as
+# install_claude_md_fragments (preserve all content outside the markers,
+# trim trailing blank lines, idempotent), so hand-written brain2 prose above
+# the block survives every refresh untouched.
+refresh_brain2_vibe_note() {
+  local p
+  p=$(_brain2_source)
+  [ -n "$p" ] || return 0
+  [ -d "$p" ] || return 0
+
+  mkdir -p "$p/meta" 2>/dev/null || return 0
+  [ -w "$p/meta" ] || return 0
+
+  local note="$p/meta/vibe-operation.md"
+  local open_delim='<!-- >>> vibe-cli-help (auto, do not edit) >>>'
+  local close_delim='<!-- <<< vibe-cli-help <<< -->'
+
+  if [ ! -f "$note" ]; then
+    printf '%s\n' "# vibe — CLI operation (auto-maintained)" > "$note" 2>/dev/null || return 0
+  fi
+
+  local remaining
+  remaining=$(awk \
+    -v opentag="$open_delim" \
+    -v closetag="$close_delim" '
+    $0 == opentag  { inblock = 1; next }
+    $0 == closetag && inblock { inblock = 0; next }
+    !inblock    { lines[++n] = $0 }
+    END {
+      last = 0
+      for (i = n; i >= 1; i--) {
+        if (lines[i] != "") { last = i; break }
+      }
+      for (i = 1; i <= last; i++) print lines[i]
+    }
+  ' "$note" 2>/dev/null) || return 0
+
+  local help_text
+  help_text=$(_usage_text)
+
+  local block
+  block="${open_delim}"$'\n'"Generated by vibe $(_vibe_version) at $(date -u +%Y-%m-%dT%H:%M:%SZ)"$'\n'"\`\`\`text"$'\n'"${help_text}"$'\n'"\`\`\`"$'\n'"${close_delim}"
+
+  local tmp="$note.tmp.$$"
+  if [ -n "$remaining" ]; then
+    printf '%s\n\n%s\n' "$remaining" "$block" > "$tmp" 2>/dev/null || return 0
+  else
+    printf '%s\n' "$block" > "$tmp" 2>/dev/null || return 0
+  fi
+  mv "$tmp" "$note" 2>/dev/null || return 0
+
+  return 0
+}
