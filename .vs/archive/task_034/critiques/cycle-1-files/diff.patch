+# ── Linux host support (task_034) ─────────────────────────────────────────────
+# Defined here, ABOVE the VIBE_SOURCE_ONLY guard, so smoke-test.py can source
+# and unit-test them behind a `uname` PATH shim. Both are HOST-side helpers:
+# they run on the machine invoking `vibe`, never inside the container.
+
+# vibe_clipboard_cmd — echo the host clipboard command for the /c scratch-file
+# drain, or nothing when no supported tool is installed. Darwin keeps `pbcopy`
+# verbatim; Linux prefers Wayland, then X11. The X11 tools are invoked with
+# their explicit clipboard-selection flags on purpose: bare `xclip` / `xsel`
+# write the PRIMARY selection (middle-click paste), not the CLIPBOARD that
+# Cmd/Ctrl-V reads. Echoes a possibly multi-word command; the watcher expands
+# $COPY_CMD unquoted, which is what makes the flagged forms work.
+vibe_clipboard_cmd() {
+  if [ "$(uname -s)" = "Darwin" ]; then
+    if command -v pbcopy >/dev/null 2>&1; then
+      printf 'pbcopy'
+    fi
+    return 0
+  fi
+  if command -v wl-copy >/dev/null 2>&1; then
+    printf 'wl-copy'
+  elif command -v xclip >/dev/null 2>&1; then
+    printf 'xclip -selection clipboard'
+  elif command -v xsel >/dev/null 2>&1; then
+    printf 'xsel --clipboard --input'
+  fi
+  return 0
+}
