+# _codex_dir_mode_warning <dir> — warns once at launch when the Codex login
+# directory about to be bound read-write (it holds a live ChatGPT OAuth
+# token, refreshed in place) grants ANY permission bit to group or others.
+# Reads the mode with the same portable stat -c/-f fallback used elsewhere in
+# this file (Linux vs. Darwin `stat` take different flags). Judges only the
+# LAST THREE octal digits, so a leading setuid/setgid/sticky digit never
+# changes the verdict (1755 warns, 4700 does not) — those bits don't affect
+# what group/other can read here. Advisory only: it never touches the mode,
+# and a non-existent path prints nothing.
+_codex_dir_mode_warning() {
+  local dir="$1" mode last3 group_other
+  [ -n "$dir" ] && [ -d "$dir" ] || return 0
+  mode="$(stat -c %a "$dir" 2>/dev/null || stat -f %Lp "$dir" 2>/dev/null)"
+  [ -n "$mode" ] || return 0
+  last3="${mode: -3}"
+  group_other="${last3:1:2}"
+  [ "$group_other" = "00" ] && return 0
+  echo "  ⚠ ${dir} is readable by group or others (mode ${mode}) — it holds a live ChatGPT login token; run 'chmod 700 ${dir}' on the Mac." >&2
+}
