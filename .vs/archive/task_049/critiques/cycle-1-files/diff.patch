+  # must be reported rather than skipped in silence.
+  if [ -n "$ws" ] && { [ -e "$f" ] || [ -L "$f" ]; }; then
+    if [ -L "$f" ]; then
+      reason="it is a symlink (the lead-runtime choice must be a real file inside the project)"
+    elif [ -L "$ws/.vibe" ]; then
