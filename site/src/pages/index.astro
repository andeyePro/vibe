---
// vibe.andeye.com — the Watchful treatment, sibling of andeye.com.
// The centrepiece is an interactive journey: a command deck (every button
// carrying a visible checklist of the real steps, in launcher order) driving
// a Ghostty-style terminal that plays out exactly what vibe does. The visitor
// drives — no autoplay. Checklist items tick as their line lands in the
// terminal; clicking a command again replays it.
// Hard rules honoured throughout: hover states change colour ONLY (nothing
// moves), and every swapped string lives in a fixed-height box sized to its
// longest string. All visible copy comes from content/home.md.
import AndeyeEye from '../components/AndeyeEye.astro';
import { frontmatter as copy, Content } from '../content/home.md';

// Terminal playback data: id -> lines, handed to the client script. The deck
// (labels, descriptions, checklists) renders server-side below and unlocked,
// so with JS off the journey still reads complete as static text; the script
// applies the locked states and drives playback, and a <noscript> line in the
// terminal owns the no-JS story.
const stepLines = Object.fromEntries(
  copy.journey.groups.flatMap((g) => g.steps).map((s) => [s.id, s.lines])
);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{copy.title} – {copy.tagline}</title>
<meta name="description" content={copy.description} />
<link rel="canonical" href="https://vibe.andeye.com/" />
<style>
  :root {
    --bg: #0c0f16;
    --bg-deep: #090b11;
    --panel: #131826;
    --panel-2: #161c2c;
    --line: #232b40;
    --line-soft: #1b2233;
    --text: #eef1f6;
    --muted: #98a0b3;
    --faint: #6a7382;
    --accent: #f0a13a;
    --accent-soft: rgba(240, 161, 58, 0.14);
    --radius: 14px;
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "SF Pro Display", Segoe UI, sans-serif;
    line-height: 1.55;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--accent); color: #14100a; }

  a { color: var(--text); }
  a:hover { color: var(--accent); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- type scale ---------- */

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0;
  }
  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 0.9rem;
  }
  :global(svg.andeye-eye) { aspect-ratio: 365 / 235; }
  .eyebrow-row :global(svg.andeye-eye) { display: block; flex: none; width: 34px; height: auto; }
  .hero .eyebrow { margin-bottom: 0.9rem; }

  h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0 0 1.1rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  p { margin: 0 0 1rem; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--muted); }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    padding: clamp(56px, 9vh, 96px) 0 40px;
    text-align: center;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: min(820px, 120vw);
    height: 620px;
    background: radial-gradient(closest-side, rgba(238, 241, 246, 0.07), rgba(238, 241, 246, 0) 72%);
    pointer-events: none;
  }

  .eyewrap {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0 auto 2.2rem;
  }
  .eyewrap :global(svg.andeye-eye) {
    display: block;
    width: clamp(170px, 24vw, 230px);
    height: auto;
  }

  .hero .sub {
    max-width: 660px;
    margin: 0 auto 1.9rem;
  }

  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.7rem;
  }

  .btn {
    display: inline-block;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .btn-primary { background: var(--accent); color: #171006; }
  /* hover states change colour ONLY — nothing on this page moves on hover */
  .btn-primary:hover { background: #ffb44f; color: #171006; }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* hover-reactive CTA subtext: answers whichever button you're on. FIXED
     height, sized to the longest of the four strings (two lines at this
     width) — nothing may shift when the text swaps. */
  .cta-sub {
    height: 3.2em;
    margin: 0 auto 0.7rem;
    max-width: 560px;
    font-size: 0.92rem;
    color: var(--muted);
    transition: color 0.25s ease;
  }
  .cta-sub.install { color: #b7c0d4; }
  .cta-sub.register { color: #9fc9a8; }
  .cta-sub.andeye { color: #f4c98a; }

  .fineprint {
    font-size: 0.85rem;
    color: var(--faint);
    margin: 0;
  }

  /* quiet pointer to the interactive demo below the fold */
  .see-demo { margin: 1.4rem 0 0; font-size: 0.9rem; }
  .see-demo a { color: var(--muted); text-decoration: none; }
  .see-demo a:hover { color: var(--accent); }

  /* ---------- load choreography ---------- */

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.in { opacity: 1; transform: none; }

  /* ---------- the journey: command deck + Ghostty window ---------- */

  .journey .lede { max-width: 760px; }

  /* status note under the lede: fixed height, text swaps, colour-only */
  .drive-note {
    height: 1.5em;
    margin: 0 0 1.6rem;
    font-size: 0.9rem;
    color: var(--faint);
    transition: color 0.25s ease;
  }
  .drive-note.hot { color: var(--accent); }

  .jgrid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 26px;
    align-items: start;
  }

  /* the deck: every command carries its checklist, always visible — if the
     terminal scrolls past too fast, the steps are still right here */
  .dgroup { margin: 0 0 1.6rem; }
  .dlabel {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.6rem;
  }
  .dstep { margin: 0 0 1.1rem; }
  .chip {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    padding: 10px 14px;
    cursor: pointer;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .chip:hover { border-color: rgba(240, 161, 58, 0.45); }
  .chip.running { border-color: var(--accent); background: var(--panel-2); }
  .chip-label { display: block; font-weight: 700; font-size: 0.95rem; }
  .chip-cmd {
    display: block;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chip-desc {
    margin: 0.35rem 0 0.3rem;
    font-size: 0.8rem;
    color: var(--faint);
  }
  .dstep.locked .chip { opacity: 0.45; cursor: default; }
  .dstep.locked .chip:hover { border-color: var(--line-soft); }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0 0 0 2px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .steps li {
    display: grid;
    grid-template-columns: 1.2em 1fr;
    gap: 6px;
    padding: 1.5px 0;
    transition: color 0.25s ease;
  }
  .steps li .tick { color: var(--faint); transition: color 0.25s ease; }
  .steps li.done { color: #c7d4c9; }
  .steps li.done .tick { color: #6fc287; }

  /* the Ghostty window: sticky, so it stays beside the deck as you scroll */
  .termcol { position: sticky; top: 24px; }
  .term {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    background: #1a2131;
    border-bottom: 1px solid var(--line-soft);
  }
  .traffic { display: flex; align-items: center; gap: 7px; flex: none; }
  .traffic i { width: 11px; height: 11px; border-radius: 50%; display: block; }
  .traffic .tl-c { background: #ff5f57; }
  .traffic .tl-m { background: #febc2e; }
  .traffic .tl-z { background: #28c840; }
  .wtitle {
    margin-left: 7px;
    font-size: 0.72rem;
    color: #8b93a8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-body {
    /* bounded by the viewport so the sticky column can never overflow it —
       on a short desktop window the terminal shrinks instead of pinning its
       bottom (where new lines land) out of reach. 200px ≈ chrome + caption +
       the sticky top gap. vh fallback first, dvh where supported. */
    height: clamp(180px, calc(100vh - 200px), 460px);
    height: clamp(180px, calc(100dvh - 200px), 460px);
    overflow-y: auto;
    padding: 16px 18px;
    background: #0e1220;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .term-hint { color: var(--faint); }
  .tline {
    display: grid;
    grid-template-columns: 8ch 1fr;
    gap: 14px;
    align-items: baseline;
  }
  .trole { text-align: right; font-weight: 700; }
  .ttext { color: var(--muted); overflow-wrap: break-word; }
  .r-vibe     { color: var(--accent); }
  .r-claude   { color: #8fb6e8; }
  .r-planner  { color: #7fb2f0; }
  .r-critic   { color: var(--accent); }
  .r-builder  { color: #c9a7ea; }
  .r-tester   { color: #6fc287; }
  .r-reviewer { color: #e08a8a; }
  .r-guard    { color: #e08a8a; }
  .r-out      { color: var(--muted); }
  .tline.tone-fail .ttext { color: #d98d86; }
  .tline.tone-pass .ttext { color: #7fc492; }
  .tline.t-cmd .ttext { color: var(--text); }
  .tline.t-cmd .trole { color: var(--faint); font-weight: 400; }

  /* the live prompt line: a block caret, blinking like the real thing */
  .tlive { display: grid; grid-template-columns: 8ch 1fr; gap: 14px; }
  .tlive .trole { color: var(--faint); font-weight: 400; }
  .tcaret {
    display: inline-block;
    width: 0.6em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--muted);
    animation: caret 1.1s steps(1) infinite;
  }
  @keyframes caret { 50% { background: transparent; } }

  .demo-caption {
    margin: 14px 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  /* ---------- sections ---------- */

  section { padding: clamp(64px, 11vh, 120px) 0; }

  /* the intro statement: the markdown body, big and plain */
  .what { background: var(--bg-deep); border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
  .what .wrap { max-width: 860px; }
  .what-prose :global(p) {
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 800px;
    margin: 0;
  }
  .what-prose :global(strong) { color: var(--text); font-weight: 800; }

  /* who it's for: short and plain, with the mark keeping watch beside it */
  .who-wrap { display: flex; align-items: center; gap: 48px; }
  .who-text { flex: 1; min-width: 0; }
  .who-text .lede { max-width: 640px; }
  .who-wrap :global(svg.who-mark) { flex: none; width: clamp(96px, 14vw, 150px); height: auto; opacity: 0.9; }
  @media (max-width: 640px) { .who-wrap :global(svg.who-mark) { display: none; } }

  /* ---------- footer ---------- */

  footer {
    border-top: 1px solid var(--line-soft);
    padding: 40px 0 56px;
    color: var(--faint);
    font-size: 0.88rem;
  }
  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  footer nav { display: flex; gap: 22px; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--accent); }
  footer p { margin: 0; }

  /* ---------- responsive ---------- */

  @media (max-width: 860px) {
    .jgrid { grid-template-columns: 1fr; }
    /* terminal first and sticky on top, deck scrolls beneath it — a click
       anywhere on the deck always has the terminal in view */
    .termcol { order: -1; position: sticky; top: 0; z-index: 3; padding: 8px 0; background: var(--bg); }
    .term-body { height: min(260px, calc(100dvh - 160px)); font-size: 0.72rem; }
    .tline, .tlive { grid-template-columns: 6.5ch 1fr; gap: 10px; }
    /* the caption is not part of the demo — don't let it eat sticky space
       on a phone screen */
    .demo-caption { display: none; }
    .who-wrap { gap: 0; }
  }

  /* ---------- reduced motion: final states, no choreography ---------- */

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .reveal { opacity: 1; transform: none; }
  }
</style>
<noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
</head>
<body>

<header class="hero" id="top">
  <div class="wrap">
    <div class="eyewrap" role="img" aria-label="The vibe andeye mark: a single-stroke ampersand that closes into an eye, with a code prompt as its iris">
      <AndeyeEye variant="vibe" weight="fill" background="#0c0f16" />
    </div>
    <p class="eyebrow reveal" style="--d:0s">{copy.hero.eyebrow}</p>
    <h1 class="reveal" style="--d:0.08s">{copy.hero.h1[0]}<br>{copy.hero.h1[1]}</h1>
    <p class="sub lede reveal" style="--d:0.16s">{copy.hero.lede}</p>
    <div class="ctas reveal" style="--d:0.26s">
      <a class="btn btn-primary" id="ctaInstall" href={copy.hero.cta_install_href}>{copy.hero.cta_install_label}</a>
      <a class="btn btn-ghost" id="ctaRegister" href={copy.hero.cta_register_href}>{copy.hero.cta_register_label}</a>
      <a class="btn btn-ghost" id="ctaAndeye" href="https://andeye.com">{copy.hero.cta_andeye_label}</a>
    </div>
    <p class="cta-sub reveal" id="ctaSub" style="--d:0.3s" aria-live="polite">{copy.hero.sub_default}</p>
    <p class="fineprint reveal" style="--d:0.34s">{copy.hero.fineprint}</p>
    <p class="see-demo reveal" style="--d:0.4s"><a href="#demo">{copy.hero.see_demo_label}</a></p>
  </div>
</header>

<section class="journey" id="demo">
  <div class="wrap">
    <!-- legacy anchors: the flow and sandbox sections this journey replaced
         were linkable as #how / #sandbox on the live site — land those here -->
    <span id="how" aria-hidden="true"></span>
    <span id="sandbox" aria-hidden="true"></span>
    <div class="eyebrow-row">
      <AndeyeEye variant="vibe" weight="fill" background="#0c0f16" />
      <p class="eyebrow">{copy.journey.eyebrow}</p>
    </div>
    <h2>{copy.journey.h2}</h2>
    <p class="lede">{copy.journey.lede}</p>
    <p class="drive-note" id="driveNote" aria-live="polite">{copy.journey.hint}</p>
    <div class="jgrid">
      <div class="deck" id="deck">
        {copy.journey.groups.map((g) => (
          <div class="dgroup">
            <p class="dlabel">{g.label}</p>
            {g.steps.map((s) => (
              <div class="dstep" id={`step-${s.id}`}>
                <button type="button" class="chip" data-step={s.id}>
                  <span class="chip-label">{s.label}</span>
                  <span class="chip-cmd">{s.cmd}</span>
                </button>
                <p class="chip-desc">{s.desc}</p>
                <ol class="steps">
                  {s.checklist.map((c) => (
                    <li><span class="tick" aria-hidden="true">○</span><span>{c}</span></li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="termcol">
        <div class="term" aria-label="A vibe session, played out as you click">
          <div class="chrome">
            <span class="traffic" aria-hidden="true"><i class="tl-c"></i><i class="tl-m"></i><i class="tl-z"></i></span>
            <span class="wtitle">{copy.journey.term_title}</span>
          </div>
          <div class="term-body" id="termBody" tabindex="0">
            <noscript>
              <style>{`.tlive { display: none; } #termHint { display: none; }`}</style>
              <div class="term-hint">JavaScript is off here – the checklists under each command on the left tell the same story as the live playback would.</div>
            </noscript>
            <div class="term-hint" id="termHint">{copy.journey.hint}</div>
            <div class="tlive" id="termLive">
              <span class="trole" id="livePrompt">$</span>
              <span><span id="liveText"></span><span class="tcaret" aria-hidden="true"></span></span>
            </div>
          </div>
        </div>
        <p class="demo-caption">{copy.journey.caption}</p>
      </div>
    </div>
  </div>
</section>

<section class="what" id="what">
  <div class="wrap">
    <div class="eyebrow-row">
      <AndeyeEye variant="vibe" weight="fill" background="#090b11" />
      <p class="eyebrow">{copy.title}</p>
    </div>
    <div class="what-prose"><Content /></div>
  </div>
</section>

<section id="who">
  <div class="wrap who-wrap">
    <div class="who-text">
      <div class="eyebrow-row">
        <AndeyeEye variant="vibe" weight="fill" background="#0c0f16" />
        <p class="eyebrow">{copy.who.eyebrow}</p>
      </div>
      <h2>{copy.who.h2}</h2>
      <p class="lede">{copy.who.lede}</p>
    </div>
    <AndeyeEye variant="vibe" weight="fill" background="#0c0f16" class="who-mark" />
  </div>
</section>

<footer>
  <div class="wrap">
    <p>© {new Date().getFullYear()} {copy.footer}</p>
    <nav>
      <a href="https://andeye.com">andeye.com</a>
      <a href="https://andeye.com/terms/">Terms</a>
      <a href="https://andeye.com/privacy/">Privacy</a>
      <a href="#top">{copy.title}</a>
    </nav>
  </div>
</footer>

<script is:inline define:vars={{ COPY: {
  subs: {
    default: copy.hero.sub_default,
    install: copy.hero.sub_install,
    register: copy.hero.sub_register,
    andeye: copy.hero.sub_andeye,
  },
  notes: {
    hint: copy.journey.hint,
    locked: copy.journey.locked_note,
    running: copy.journey.running_note,
  },
  lines: stepLines,
} }}>
// Astro wraps define:vars scripts in an IIFE, so `COPY` is scoped to this
// block and is NOT a global on its own. Export it explicitly - the main
// script below reads it. Removing this line kills the whole page script.
window.COPY = COPY;
</script>
<script is:inline>
// Failsafe, deliberately separate from the main script below: if that script
// ever dies (an uncaught error, a missing global), the .reveal choreography
// never runs and the hero would stay invisible. This tiny independent
// watchdog reveals everything on any uncaught error, and again shortly after
// load as a catch-all. Adding "in" to an already-revealed element is a no-op,
// so it never fights the normal choreography.
(function () {
  function show() {
    var els = document.querySelectorAll('.reveal:not(.in)');
    for (var i = 0; i < els.length; i++) els[i].classList.add('in');
  }
  window.addEventListener('error', function () { setTimeout(show, 0); });
  window.addEventListener('load', function () { setTimeout(show, 3200); });
})();
</script>
<script is:inline>
(function () {
'use strict';

var COPY = window.COPY;
var reduced = window.matchMedia
  && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// --- load: everything reveals on its own stagger ---
function revealAll() {
  document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
}
if (reduced) {
  revealAll();
} else {
  requestAnimationFrame(function () { requestAnimationFrame(revealAll); });
}

// --- hover-reactive CTA subtext (fixed-height box: text swaps, nothing
// moves; colour is the only other thing that changes) ---
var ctaSub = document.getElementById('ctaSub');
function sub(kind) {
  ctaSub.textContent = COPY.subs[kind];
  ctaSub.classList.toggle('install', kind === 'install');
  ctaSub.classList.toggle('register', kind === 'register');
  ctaSub.classList.toggle('andeye', kind === 'andeye');
}
[['ctaInstall', 'install'], ['ctaRegister', 'register'], ['ctaAndeye', 'andeye']].forEach(function (pair) {
  var el = document.getElementById(pair[0]);
  ['mouseenter', 'focus'].forEach(function (ev) {
    el.addEventListener(ev, function () { sub(pair[1]); });
  });
  ['mouseleave', 'blur'].forEach(function (ev) {
    el.addEventListener(ev, function () { sub('default'); });
  });
});

// --- the journey: chips play their transcript into the terminal; each
// checklist item ticks when its line lands. Clicking again replays (the
// terminal appends a fresh run, like a real terminal would). Everything but
// Launch stays locked until Launch has run once. ---

var body = document.getElementById('termBody');
var live = document.getElementById('termLive');
var livePrompt = document.getElementById('livePrompt');
var liveText = document.getElementById('liveText');
var termHint = document.getElementById('termHint');
var driveNote = document.getElementById('driveNote');

var launched = false;
var playing = false;
var timers = [];
var noteTimer = null;

// The deck renders unlocked server-side (so a dead script leaves plain,
// readable chips, not dimmed ones) — the lock states are script-applied.
function setLocked(el, on) {
  el.classList.toggle('locked', on);
  var chip = el.querySelector('.chip');
  if (chip) chip.setAttribute('aria-disabled', on ? 'true' : 'false');
}
document.querySelectorAll('.dstep').forEach(function (d) {
  setLocked(d, d.id !== 'step-launch');
});

function note(text, hot) {
  clearTimeout(noteTimer);
  driveNote.textContent = text;
  driveNote.classList.toggle('hot', !!hot);
}

function promptFor(l) { return l.sh ? '$' : '>'; }

function appendLine(l) {
  var div = document.createElement('div');
  div.className = 'tline' + (l.cmd ? ' t-cmd' : '') + (l.tone ? ' tone-' + l.tone : '');
  var role = document.createElement('span');
  var text = document.createElement('span');
  role.className = 'trole' + (l.cmd ? '' : ' r-' + l.role);
  role.textContent = l.cmd ? promptFor(l) : l.role;
  text.className = 'ttext';
  text.textContent = l.text;
  div.appendChild(role);
  div.appendChild(text);
  body.insertBefore(div, live);
  body.scrollTop = body.scrollHeight;
}

function tick(box, n) {
  if (!n) return;
  var li = box.querySelectorAll('.steps li')[n - 1];
  if (!li) return;
  li.classList.add('done');
  var t = li.querySelector('.tick');
  if (t) t.textContent = '✓';
}

function resetTicks(box) {
  box.querySelectorAll('.steps li').forEach(function (li) {
    li.classList.remove('done');
    var t = li.querySelector('.tick');
    if (t) t.textContent = '○';
  });
}

function finishStep(id, chip) {
  playing = false;
  chip.classList.remove('running');
  liveText.textContent = '';
  note(COPY.notes.hint, false);
  if (id === 'launch' && !launched) {
    launched = true;
    document.querySelectorAll('.dstep.locked').forEach(function (d) {
      setLocked(d, false);
    });
  }
  livePrompt.textContent = launched ? '>' : '$';
}

// appendLine/tick are wrapped so one bad line can never strand `playing` —
// finishStep runs on its own timer regardless (the deck must never brick).
function emit(l, box) {
  try { appendLine(l); tick(box, l.step); } catch (e) { /* keep playing */ }
}

function play(id, chip) {
  var box = document.getElementById('step-' + id);
  if (box.classList.contains('locked')) {
    // locked feedback outranks the in-flight guard, and the note restores
    // itself — text swap only, in its fixed-height box
    note(COPY.notes.locked, true);
    noteTimer = setTimeout(function () { note(COPY.notes.hint, false); }, 3000);
    return;
  }
  if (playing) return;
  var lines = COPY.lines[id];
  if (!lines || !lines.length) return;
  playing = true;
  chip.classList.add('running');
  note(COPY.notes.running, true);
  if (termHint) { termHint.remove(); termHint = null; }
  resetTicks(box);
  timers.forEach(clearTimeout);
  timers = [];

  if (reduced) {
    lines.forEach(function (l) { emit(l, box); });
    finishStep(id, chip);
    return;
  }

  // the command types itself at the live prompt, then commits to history
  var cmd = lines[0];
  livePrompt.textContent = promptFor(cmd);
  var i = 0;
  (function type() {
    if (i <= cmd.text.length) {
      liveText.textContent = cmd.text.slice(0, i);
      i += 2;
      timers.push(setTimeout(type, 22));
      return;
    }
    liveText.textContent = '';
    emit(cmd, box);
    var at = 0;
    lines.slice(1).forEach(function (l) {
      at += l.tone ? 800 : 430;
      timers.push(setTimeout(function () { emit(l, box); }, at));
    });
    // completion is its own timer, never piggy-backed on a line that might
    // throw — and correct even for a single-line step
    timers.push(setTimeout(function () { finishStep(id, chip); }, at + 60));
  })();
}

document.querySelectorAll('.chip').forEach(function (chip) {
  chip.addEventListener('click', function () {
    play(chip.getAttribute('data-step'), chip);
  });
});

})();
</script>
</body>
</html>
