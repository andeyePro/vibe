# Never commit tokens or personal config
*.tokens
.env
.env.*

# macOS
.DS_Store

# Python bytecode (smoke-test.py + code-check.py)
__pycache__/
*.pyc

# vibe.andeye.com site (site/) — build artifacts only; src stays tracked
site/node_modules/
site/dist/
site/.astro/

# /vs per-cycle artifacts (spec.md, progress.md, tasks.json stay tracked)
.vs/cycle-*/

# /vss + /vsss ephemeral state (.vss/sessions/*.md is the committed audit trail)
.vss/last-plan.md
.vss/auto-resume
.vss/heartbeat*
.vss/rate-limit*

# >>> vibe-managed runtime exclusions (auto-added; do not edit body) >>>
# Files vibe writes to /workspace at runtime. Committing them
# leaks per-machine state into the repo (PR-review-noise risk).
# Opt out: set VIBE_AUTO_GITIGNORE=0 before container start, or
# delete this entire block (won't be re-added once removed).
.claude/settings.local.json
.vibe/
.vibe-signals/
# <<< vibe-managed <<<

# Claude Code agent worktrees (transient, harness-managed)
.claude/worktrees/

# per-project OpenProject opt-in marker (task_020) - always untracked
.vibe-allow-op
.vibe-allow-codex

# per-project extra firewall domains (task_041) - always untracked.
# .vibe/ is already covered by the vibe-managed block above; this entry is
# explicit because untrackedness is a SECURITY property here, not tidiness:
# a committed .vibe/domains is refused by the launcher, so a repo can never
# widen the firewall of every container that clones it.
.vibe/domains
.vibe/review-slots

# per-project lead-runtime choice (task_049) - always untracked, for the same
# reason: a committed .vibe/agent would let a PR pick the runtime that leads
# every container cloning this repo, so the launcher refuses a tracked one.
.vibe/agent
